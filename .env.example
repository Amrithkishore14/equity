# Server
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace_with_strong_secret
PEPPER=replace_with_strong_pepper
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Database
DB_PATH=database.sqlite

# Email (optional for contact + digest)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_TO=alerts@equityinvestorclub.com

# Stock master sources (optional overrides)
NSE_EQ_CSV=https://archives.nseindia.com/content/equities/EQUITY_L.csv
BSE_EQ_CSV=https://api.bseindia.com/BseIndiaAPI/api/DownloadCSV?strType=EQ

# Branding
SITE_URL=https://equityinvestorclub.com

# Payments (Razorpay)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional promo codes (comma-separated, invite-only)
PROMO_CODES=STOCKAKM@6
